# Per-machine toolchain paths. Copy to scripts\local.env.ps1 (gitignored) and edit.
# ASCII only on purpose (PowerShell 5.1 + non-ASCII script bytes is a known trap).

# JDK 17+ used by gradlew (must be a 64-bit JVM: the daemon heap is -Xmx2560m).
$env:JAVA_HOME = "C:\path\to\jdk-17"

# Android SDK (platform-tools\adb.exe must exist under it).
$env:ANDROID_HOME = "C:\path\to\android-sdk"
$env:ANDROID_SDK_ROOT = $env:ANDROID_HOME

# Optional: python interpreter for tools\*.py (defaults to "python" on PATH).
# $env:READIT_PYTHON = "C:\path\to\python.exe"
