<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readit_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
            渲染舞台：TXT / EPUB-文本降级 用 TxtCanvasView；
            EPUB 完整渲染的 WebView 由代码按需 addView —— 打开 TXT 时不该白白构造 WebView
            （1GB 设备上 WebView 实例常占 30-60MB）。
        -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.readit.reader.txt.TxtCanvasView
                android:id="@+id/txtCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/panelTypography"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/readit_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_font_size"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbFontSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/label_font_size" />

                <TextView
                    android:id="@+id/tvFontValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="end"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_line_spacing"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbLineSpacing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/label_line_spacing" />

                <TextView
                    android:id="@+id/tvLineValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="end"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_margin"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbMargin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/label_margin" />

                <TextView
                    android:id="@+id/tvMarginValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="end"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_font_family"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spFontFamily"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/label_font_family" />
            </LinearLayout>

            <!-- F27：墨水屏只有黑白两级，没有「背景色」可调，能调的是黑白置换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@+id/swInvert"
                    android:text="@string/label_invert"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/swInvert"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/label_invert" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/readit_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btnToc"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_toc"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnBookmark"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_bookmark"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTypography"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_typography"
                android:textSize="13sp" />

            <!--
                F15：手动选择编码的常驻入口。
                只靠「自动检测失败 / 解出乱码」自动弹是不够的——单字节编码
                （KOI8-R / ISO-8859-1）解任何字节都不产生替换字符，误检时
                乱码判定抓不到，用户必须有个随时能改的地方。
                仅自绘文本模式有意义，由代码控制显隐。
            -->
            <Button
                android:id="@+id/btnEncoding"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_encoding"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnRefresh"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_refresh"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSettings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_settings"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:textColor="@color/readit_fg_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 目录：宽度 90vw 由代码设置 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvToc"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/readit_bg" />
</androidx.drawerlayout.widget.DrawerLayout>
