<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readit_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
            渲染舞台：TXT / EPUB-文本降级 用 TxtCanvasView；
            EPUB 完整渲染的 WebView 由代码按需 addView —— 打开 TXT 时不该白白构造 WebView
            （1GB 设备上 WebView 实例常占 30-60MB）。
        -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.readit.reader.txt.TxtCanvasView
                android:id="@+id/txtCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/panelTypography"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/readit_bg"
            android:orientation="vertical"
            android:padding="@dimen/reader_padding"
            android:visibility="gone">

            <!--
                固定版式提示（PDF / DOCX 原版渲染）：字号 / 行距 / 边距不参与排版。
                显隐由代码 syncTypographyPanelForMode() 控制，避免「滑条拖了没反应」的错觉
                （Civi2 真机反馈）。文本类渲染路径（TXT / EPUB / DOCX / PDF 降级文本）不显示。
            -->
            <TextView
                android:id="@+id/tvTypographyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/typography_fixed_hint"
                android:textColor="@color/readit_fg_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <!--
                F27：墨水屏只有黑白两级，没有「背景色」可调，能调的是黑白置换。

                放在面板**最上面**而不是最下面：它是唯一「一打开就全屏生效」的开关
                （正文、工具栏、目录一起翻），放在最底要滚过一整列滑条才够得着。
                下面那条分隔线把它与「文字排版」分组隔开。
            -->
            <!-- F27：墨水屏只有黑白两级，没有「背景色」可调，能调的是黑白置换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@+id/swInvert"
                    android:text="@string/label_invert"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/swInvert"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/label_invert" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:background="@color/readit_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_font_size"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbFontSize"
                    style="@style/InkSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/label_font_size" />

                <TextView
                    android:id="@+id/tvFontValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="end"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_line_spacing"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbLineSpacing"
                    style="@style/InkSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/label_line_spacing" />

                <TextView
                    android:id="@+id/tvLineValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="end"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_margin"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbMargin"
                    style="@style/InkSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/label_margin" />

                <TextView
                    android:id="@+id/tvMarginValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="end"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_font_family"
                    android:textColor="@color/readit_fg"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spFontFamily"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/label_font_family" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/readit_divider" />


        <!--
            阅读状态条：分隔线 + 进度条 + 「第 X / Y 页」+ 书名。

            为什么放在正文**下方**而不是上方：600×800 这类兜底屏的垂直空间极紧张，
            顶部信息条会实打实挤掉正文行数。放下方则完全不占正文高度
            （原本这里就有一行页码，只是把信息补全）。

            布局参考同类墨水屏阅读器（KOReader / EinkBro / 微信读书墨水屏版）：
            底部一条固定的状态区，左侧页码、右侧书名，中间不塞任何可点的东西 ——
            墨水屏上每一块可点区域都要付出重绘成本，且误触成本高。

            整块包在 barStatus 里是**反色**的需要（见 chromeViews()）：
            分隔线、进度条、页码、书名必须一起翻，
            否则只翻其中一部分会得到「黑底上一条浅灰线 + 半黑半白文字」的割裂。
        -->
        <LinearLayout
            android:id="@+id/barStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/readit_divider" />

            <ProgressBar
                android:id="@+id/pbReadingProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:max="100"
                android:progressDrawable="@drawable/progress_ink"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvPageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/readit_fg"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvBookTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/readit_fg_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/barButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btnToc"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_toc"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnBookmark"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_bookmark"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTypography"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_typography"
                android:textSize="13sp" />

            <!--
                F15：手动选择编码的常驻入口。
                只靠「自动检测失败 / 解出乱码」自动弹是不够的——单字节编码
                （KOI8-R / ISO-8859-1）解任何字节都不产生替换字符，误检时
                乱码判定抓不到，用户必须有个随时能改的地方。
                仅自绘文本模式有意义，由代码控制显隐。
            -->
            <Button
                android:id="@+id/btnEncoding"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_encoding"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnRefresh"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_refresh"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSettings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/action_settings"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 目录：宽度 90vw 由代码设置 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvToc"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/readit_bg" />
</androidx.drawerlayout.widget.DrawerLayout>
