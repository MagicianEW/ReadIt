<?xml version="1.0" encoding="utf-8"?>
<!--
    设备报告 / 按键采集（Phase 4 设备收集工具）。
    600×800 兜底：整体可滚动，按钮 ≥ @dimen/touch_target_min。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readit_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diag_report_title"
            android:textColor="@color/readit_fg"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingMultiplier="1.25"
            android:paddingTop="8dp"
            android:textColor="@color/readit_fg"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/readit_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/diag_key_title"
            android:textColor="@color/readit_fg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="@string/diag_key_desc"
            android:textColor="@color/readit_fg_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnProbe"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/diag_key_start"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnProbeClear"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/diag_key_clear"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvKeySamples"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingMultiplier="1.25"
            android:paddingTop="8dp"
            android:textColor="@color/readit_fg"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/readit_divider" />

        <Button
            android:id="@+id/btnExportReport"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="12dp"
            android:text="@string/diag_export_report"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnExportProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/diag_export_profile"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/diag_copy"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
