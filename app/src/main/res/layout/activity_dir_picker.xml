<?xml version="1.0" encoding="utf-8"?>
<!-- 书籍目录选择器（墨水屏友好：无动画、列表项与按钮均 ≥ touch_target_min） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readit_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvDirPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textColor="@color/readit_fg"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDirUp"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_weight="1"
            android:text="@string/dir_picker_up"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDirNew"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_weight="1"
            android:text="@string/dir_picker_new"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDirEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/dir_picker_empty"
        android:textColor="@color/readit_fg_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvDirs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/readit_divider"
        android:dividerHeight="1dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/readit_divider" />

    <Button
        android:id="@+id/btnDirSelect"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginTop="8dp"
        android:text="@string/dir_picker_select"
        android:textSize="14sp" />
</LinearLayout>
