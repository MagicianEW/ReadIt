<?xml version="1.0" encoding="utf-8"?>
<!--
    首次启动引导（Phase 4）。
    600×800 兜底口径：内容全部包在 ScrollView 里，600×480（KY-01L）也不会被截断；
    所有可点元素 ≥ @dimen/touch_target_min（48dp / sw600dp 56dp）；无任何动画。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readit_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvOnboardStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/readit_fg_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvOnboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:textColor="@color/readit_fg"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOnboardDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:paddingBottom="12dp"
            android:textColor="@color/readit_fg_secondary"
            android:textSize="14sp" />

        <!-- 步骤 1：性能档位 -->
        <LinearLayout
            android:id="@+id/grpTier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTierDetected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textColor="@color/readit_fg"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rgTier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbTierAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/pref_perf_tier_auto"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbTierFallback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/pref_perf_tier_fallback"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbTierStandard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/pref_perf_tier_standard"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbTierEnhanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/pref_perf_tier_enhanced"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 步骤 2：刷新模式 -->
        <LinearLayout
            android:id="@+id/grpRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RadioGroup
                android:id="@+id/rgRefresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbRefreshAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/refresh_auto"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbRefreshQuality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/refresh_quality"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbRefreshFast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/refresh_fast"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbRefreshRegal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/refresh_regal"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbRefreshSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/refresh_system"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 步骤 3：按键学习 -->
        <LinearLayout
            android:id="@+id/grpInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnLearnKey"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/pref_key_learn"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLearnedKeys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"
                android:paddingTop="12dp"
                android:textColor="@color/readit_fg_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 步骤 4：导入第一本书 -->
        <LinearLayout
            android:id="@+id/grpImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnPickBook"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/action_import"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvImported"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"
                android:paddingTop="12dp"
                android:textColor="@color/readit_fg_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/readit_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/onboard_prev"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSkip"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/onboard_skip"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/onboard_next"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
