<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/cat_storage">
        <Preference
            app:key="books_dir"
            app:summary="@string/pref_books_dir_summary"
            app:title="@string/pref_books_dir" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_performance">
        <ListPreference
            app:defaultValue="AUTO"
            app:entries="@array/perf_tier_entries"
            app:entryValues="@array/perf_tier_values"
            app:key="perf_tier"
            app:title="@string/pref_perf_tier" />

        <ListPreference
            app:defaultValue="AUTO"
            app:entries="@array/refresh_mode_entries"
            app:entryValues="@array/refresh_mode_values"
            app:key="refresh_mode"
            app:title="@string/pref_refresh_mode" />

        <Preference
            app:key="device_profile_import"
            app:summary="@string/pref_device_profile_import_summary"
            app:title="@string/pref_device_profile_import" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_typography">
        <SeekBarPreference
            app:defaultValue="14"
            app:key="font_size"
            app:showSeekBarValue="true"
            app:title="@string/pref_font_size" />

        <!-- 条目动态拼（用户字体随时可增删），summary 由 useSimpleSummaryProvider 显示当前项 -->
        <ListPreference
            app:defaultValue="default"
            app:key="font_family"
            app:title="@string/pref_font_family"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="invert"
            app:summary="@string/pref_invert_summary"
            app:title="@string/pref_invert" />

        <Preference
            app:key="font_dir"
            app:selectable="false"
            app:title="@string/pref_font_dir" />
    </PreferenceCategory>

    <!-- 屏幕适配：首启检测分辨率/密度后，这里给出结论并允许手动覆盖渲染模式 -->
    <PreferenceCategory app:title="@string/cat_display">
        <ListPreference
            app:defaultValue="AUTO"
            app:entries="@array/render_mode_entries"
            app:entryValues="@array/render_mode_values"
            app:key="render_mode"
            app:title="@string/pref_render_mode" />

        <Preference
            app:key="screen_info"
            app:selectable="false"
            app:title="@string/pref_screen_info" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_reading">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="pdf_crop"
            app:summary="@string/pref_pdf_crop_summary"
            app:title="@string/pref_pdf_crop" />

        <EditTextPreference
            app:defaultValue="3"
            app:dialogTitle="@string/pref_scan_sample_pages"
            app:key="scan_sample_pages"
            app:summary="@string/pref_scan_sample_pages_summary"
            app:title="@string/pref_scan_sample_pages" />

        <EditTextPreference
            app:defaultValue="100"
            app:dialogTitle="@string/pref_scan_min_chars"
            app:key="scan_min_chars"
            app:summary="@string/pref_scan_min_chars_summary"
            app:title="@string/pref_scan_min_chars" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_light">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="light_on"
            app:summary="@string/pref_light_on_summary"
            app:title="@string/pref_light_on" />

        <SeekBarPreference
            app:defaultValue="50"
            app:key="light_level"
            app:min="0"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:summary="@string/pref_light_level_summary"
            app:title="@string/pref_light_level" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_sync">
        <EditTextPreference
            app:key="webdav_url"
            app:summary="@string/pref_webdav_url_summary"
            app:title="@string/pref_webdav_url" />

        <EditTextPreference
            app:key="webdav_user"
            app:title="@string/pref_webdav_user" />

        <EditTextPreference
            app:key="webdav_password"
            app:title="@string/pref_webdav_password" />

        <EditTextPreference
            app:defaultValue="/ReadIt"
            app:key="webdav_dir"
            app:summary="@string/pref_webdav_dir_summary"
            app:title="@string/pref_webdav_dir" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="sync_auto"
            app:summary="@string/pref_sync_auto_summary"
            app:title="@string/pref_sync_auto" />

        <Preference
            app:key="sync_strategy"
            app:selectable="false"
            app:title="@string/pref_sync_strategy" />

        <Preference
            app:key="sync_now"
            app:summary="@string/pref_sync_now_summary"
            app:title="@string/pref_sync_now" />

        <Preference
            app:key="sync_reset"
            app:summary="@string/pref_sync_reset_summary"
            app:title="@string/pref_sync_reset" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_backup">
        <Preference
            app:key="backup_export"
            app:summary="@string/pref_backup_export_summary"
            app:title="@string/pref_backup_export" />

        <Preference
            app:key="backup_import"
            app:summary="@string/pref_backup_import_summary"
            app:title="@string/pref_backup_import" />

        <!-- F28：云端版本化备份（走 WebDAV，一次打包配置 + 统计 + 进度 + 书签） -->
        <Preference
            app:key="backup_cloud_create"
            app:summary="@string/pref_backup_cloud_create_summary"
            app:title="@string/pref_backup_cloud_create" />

        <Preference
            app:key="backup_cloud_restore"
            app:summary="@string/pref_backup_cloud_restore_summary"
            app:title="@string/pref_backup_cloud_restore" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_input">
        <Preference
            app:key="key_learn"
            app:summary="@string/pref_key_learn_summary"
            app:title="@string/pref_key_learn" />

        <Preference
            app:key="key_reset"
            app:summary="@string/pref_key_reset_summary"
            app:title="@string/pref_key_reset" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_about">
        <Preference
            app:key="about"
            app:summary="@string/pref_about_summary"
            app:title="@string/pref_about" />

        <Preference
            app:key="eal_summary"
            app:selectable="false"
            app:title="@string/pref_eal" />

        <Preference
            app:key="app_version"
            app:selectable="false"
            app:title="@string/pref_app_version" />

        <Preference
            app:key="device_info"
            app:summary="@string/pref_device_info_summary"
            app:title="@string/pref_device_info" />

        <Preference
            app:key="device_report"
            app:summary="@string/pref_device_report_summary"
            app:title="@string/pref_device_report" />

        <Preference
            app:key="rerun_onboarding"
            app:summary="@string/pref_rerun_onboarding_summary"
            app:title="@string/pref_rerun_onboarding" />
    </PreferenceCategory>
</PreferenceScreen>
