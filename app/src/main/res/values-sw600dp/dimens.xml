<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      EXPANDED 档（sw600dp 及以上），与 ScreenProfile.UiSizeClass.EXPANDED 对齐
      （图标 44dp / 热区 56dp / 默认字号 16sp）。

      顺带修正：这一桶原先写的是 40dp 图标，与新增的 MEDIUM 档（sw400dp，40dp）
      几乎没拉开差距，等于「大屏」和「中屏」尺寸一样、分档形同虚设。

      注意「>=758px」的旧注释是错的：资源限定符按 **dp** 匹配而不是像素，
      758px 的机器到底是几 dp 取决于它的 dpi（EPD106 758px@212dpi 只有约 572dp，
      命中的是 sw400dp 那一桶，不是这一桶）。
    -->
    <dimen name="toolbar_icon_size">44dp</dimen>
    <dimen name="touch_target_min">56dp</dimen>
    <dimen name="text_size_min">12sp</dimen>
    <dimen name="text_size_default">16sp</dimen>
</resources>
