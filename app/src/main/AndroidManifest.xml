<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        定时同步（§2.3 后台同步，未闭环项 A1）：用平台自带 JobScheduler，零依赖零体积。
        setPersisted(true) 需要这个权限，否则 schedule() 直接抛。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 前台服务：API 28+ 必需；API 34+ 还需按类型单独声明 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 后台同步的常驻通知（API 33+ 需运行时授权，被拒则静默降级为后台执行） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 自定义书籍目录：API≤29 用这个；API30+ 由 MANAGE_EXTERNAL_STORAGE 接管 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!--
        自定义书籍目录（API 30+）：阅读器四条读取链全走 File 绝对路径，
        无法改用 SAF 树 URI，故需要「所有文件访问」。侧载 App 的常见做法。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <application
        android:name="com.readit.eink.ReadItApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.ReadIt">

        <activity
            android:name="com.readit.ui.shelf.ShelfActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.readit.ui.reader.ReaderActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name="com.readit.ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name="com.readit.eink.ui.MainActivity"
            android:exported="false"
            android:label="@string/pref_device_info"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- 首次启动引导（Phase 4）：仅由书架在首次启动时拉起，也可从设置页重入 -->
        <activity
            android:name="com.readit.ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- 书籍目录选择器（首次引导 / 设置页共用） -->
        <activity
            android:name="com.readit.ui.storage.DirPickerActivity"
            android:exported="false"
            android:label="@string/dir_picker_title"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- 设备报告与按键采集（Phase 4 设备收集工具） -->
        <activity
            android:name="com.readit.ui.diag.DeviceCollectActivity"
            android:exported="false"
            android:label="@string/pref_device_report"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!--
            DOCX 转换独立进程（F04）：
            DOCX 子集解析是 CPU + 堆敏感操作，隔离到 :converter 后，
            即便解析进程被系统低内存杀手干掉，阅读器主进程依然存活。
        -->
        <service
            android:name="com.readit.doc.DocxConvertService"
            android:exported="false"
            android:process=":converter" />
        <!--
            定时同步入口（§2.3 A1）。BIND_JOB_SERVICE 仅授予系统，
            exported 必须放开，否则系统绑定不上。
        -->
        <service
            android:name="com.readit.sync.SyncJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- C/D 级「同步前台化」容器，仅由 SyncJobService 拉起，不做常驻 -->
        <service
            android:name="com.readit.sync.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
